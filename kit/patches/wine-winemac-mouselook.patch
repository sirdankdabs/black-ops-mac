+    /* Mouse look: a game that hides the cursor and puts it back at the center
+       after every move (160+ times a second) made us warp the real cursor each
+       time. Every warp costs WindowServer work and throws away the mouse moves
+       queued until then, so with a 1000 Hz mouse aiming stuttered and felt
+       heavy (a controller was smooth). Instead, while the cursor is hidden and
+       we are active, detach the mouse from the cursor after the first warp and
+       send every move as a delta: Wine already has the position the game set.
+       WINE_MAC_MOUSELOOK=0 turns this off. */
+    static BOOL mouselook_enabled(void)
+    {
+        static int enabled = -1;
+        if (enabled < 0)
+        {
+            const char *v = getenv("WINE_MAC_MOUSELOOK");
+            enabled = !(v && v[0] == '0');
         }
+        return enabled;
     }
 
+    - (void) endMouseLook
+    {
+        if (mouseLook)
+        {
+            mouseLook = FALSE;
+            CGAssociateMouseAndMouseCursorPosition(true);
+            forceNextMouseMoveAbsolute = TRUE;
+        }
+    }
+
