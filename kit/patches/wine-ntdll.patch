+/*
+ * x87 acceleration under Rosetta through x87sidecar
+ *
+ * x87sidecar (https://github.com/athei/x87sidecar, MIT, by athei, which grew
+ * out of Lifeisawful's rosettax87 and rosettax87_jit) hooks Rosetta's
+ * translator and turns runs of x87 instructions into native ARM64 code.
+ * Rosetta translates x87 slowly, and older 32-bit games do their physics and
+ * effects in it.
+ *
+ * Wine's side of its cooperative mode:
+ *  - x87_sidecar_exec: a new process whose program is named in
+ *    X87_SIDECAR_PROGRAMS (file names separated by ':', any case) is started
+ *    as `x87sidecar --cooperative <loader> <args>`, with x87sidecar at
+ *    X87_SIDECAR_PATH. The sidecar starts the loader with the name of a
+ *    Mach service in X87_SIDECAR_BOOTSTRAP.
+ *  - x87_sidecar_handshake: in that process, before any Windows code runs,
+ *    hand the task and thread ports to that service and wait for the reply
+ *    (the protocol of x87sidecar's rosetta_loader/src/coop_proto.h), then
+ *    invalidate the instruction cache for the code ranges the reply names.
+ * Without the variables, or when anything fails, the program runs as usual.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#ifdef __APPLE__
+
+#include <libkern/OSCacheControl.h>
+#include <mach/mach.h>
+#include <mach/notify.h>
+#include <servers/bootstrap.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <unistd.h>
+
+/* coop_proto.h of x87sidecar 1.9.1 */
+#define X87_COOP_ENV     "X87_SIDECAR_BOOTSTRAP"
+#define X87_COOP_MSGH_ID 0x78383721  /* 'x87!'; the reply uses +1 */
+
+typedef struct
+{
+    mach_msg_header_t header;
+    mach_msg_body_t body;
+    mach_msg_port_descriptor_t task_port;
+    mach_msg_port_descriptor_t thread_port;
+} x87_coop_request_t;
+
+typedef struct
+{
+    mach_msg_header_t header;
+    uint64_t icache_addr[2];
+    uint64_t icache_len[2];
+} x87_coop_reply_t;
+
+static int x87_logs(void)
+{
+    return getenv( "X87_LOGS" ) != NULL;
+}
+
+/* Whether the program at image_path is named in X87_SIDECAR_PROGRAMS. */
+static int x87_wanted( const char *image_path )
+{
+    const char *list = getenv( "X87_SIDECAR_PROGRAMS" ), *name, *p, *end;
+    size_t len;
+
+    if (!list || !*list || !image_path) return 0;
+    name = image_path;
+    for (p = image_path; *p; p++) if (*p == '/' || *p == '\\') name = p + 1;
+    len = strlen( name );
+    for (p = list; *p; p = *end ? end + 1 : end)
+    {
+        if (!(end = strchr( p, ':' ))) end = p + strlen( p );
+        if ((size_t)(end - p) == len && !strncasecmp( p, name, len )) return 1;
+    }
+    return 0;
+}
+
+/* argv[1] is the loader to exec, argv + 1 its arguments. Returns only when
+ * the program is not to be accelerated or the sidecar cannot be started. */
+void x87_sidecar_exec( char **argv, const char *image_path )
+{
+    const char *sidecar = getenv( "X87_SIDECAR_PATH" );
+    char **args;
+    int count = 0;
+
+    if (!sidecar || !*sidecar || !x87_wanted( image_path )) return;
+    /* Wine tries a loader of the program's own architecture first and falls
+     * back to its own when that one does not exist: only hand over a loader
+     * that is there */
+    if (!argv[1] || access( argv[1], X_OK )) return;
+    while (argv[1 + count]) count++;
+    if (!(args = malloc( (count + 3) * sizeof(*args) ))) return;
+    args[0] = (char *)sidecar;
+    args[1] = (char *)"--cooperative";
+    memcpy( args + 2, argv + 1, (count + 1) * sizeof(*args) );
+    if (x87_logs()) fprintf( stderr, "x87: starting %s under %s\n", image_path, sidecar );
+    execv( sidecar, args );
+    if (x87_logs()) fprintf( stderr, "x87: cannot start %s\n", sidecar );
+    free( args );
+}
+
+/* In a process started by the sidecar: hand it our task and thread ports. */
+void x87_sidecar_handshake(void)
+{
+    const char *name = getenv( X87_COOP_ENV ), *dot;
+    mach_port_t bootstrap = MACH_PORT_NULL, service = MACH_PORT_NULL, reply = MACH_PORT_NULL;
+    x87_coop_request_t msg;
+    struct
+    {
+        x87_coop_reply_t reply;
+        mach_msg_trailer_t trailer;
+        char slack[64];
+    } rep;
+    kern_return_t kr;
+    int i;
+
+    if (x87_logs()) fprintf( stderr, "x87: handshake check in pid %d, %s=%s\n", (int)getpid(), X87_COOP_ENV, name ? name : "(unset)" );
+    if (!name || !*name) return;
+    /* the name ends with the pid of the process it is meant for; a child that
+     * only inherited the variable must not answer */
+    if (!(dot = strrchr( name, '.' )) || atoi( dot + 1 ) != (int)getpid()) goto done;
+
+    if (task_get_bootstrap_port( mach_task_self(), &bootstrap ) != KERN_SUCCESS) goto done;
+    if ((kr = bootstrap_look_up( bootstrap, name, &service )) != KERN_SUCCESS)
+    {
+        if (x87_logs()) fprintf( stderr, "x87: bootstrap_look_up(%s) failed %#x\n", name, kr );
+        goto done;
+    }
+    if (mach_port_allocate( mach_task_self(), MACH_PORT_RIGHT_RECEIVE, &reply ) != KERN_SUCCESS) goto done;
+
+    memset( &msg, 0, sizeof(msg) );
+    msg.header.msgh_bits = MACH_MSGH_BITS( MACH_MSG_TYPE_COPY_SEND, MACH_MSG_TYPE_MAKE_SEND_ONCE ) |
+                           MACH_MSGH_BITS_COMPLEX;
+    msg.header.msgh_size = sizeof(msg);
+    msg.header.msgh_remote_port = service;
+    msg.header.msgh_local_port = reply;
+    msg.header.msgh_id = X87_COOP_MSGH_ID;
+    msg.body.msgh_descriptor_count = 2;
+    msg.task_port.name = mach_task_self();
+    msg.task_port.disposition = MACH_MSG_TYPE_COPY_SEND;
+    msg.task_port.type = MACH_MSG_PORT_DESCRIPTOR;
+    msg.thread_port.name = mach_thread_self();
+    msg.thread_port.disposition = MACH_MSG_TYPE_COPY_SEND;
+    msg.thread_port.type = MACH_MSG_PORT_DESCRIPTOR;
+    if ((kr = mach_msg( &msg.header, MACH_SEND_MSG, sizeof(msg), 0, MACH_PORT_NULL,
+                        MACH_MSG_TIMEOUT_NONE, MACH_PORT_NULL )) != KERN_SUCCESS)
+    {
+        if (x87_logs()) fprintf( stderr, "x87: handshake send failed %#x\n", kr );
+        goto done;
+    }
+
+    /* the sidecar replies once its hook is in place; anything else (such as
+     * the send-once notification of a sidecar that exited) means no hook */
+    memset( &rep, 0, sizeof(rep) );
+    kr = mach_msg( &rep.reply.header, MACH_RCV_MSG, 0, sizeof(rep), reply, 30000, MACH_PORT_NULL );
+    if (kr == KERN_SUCCESS && rep.reply.header.msgh_id == X87_COOP_MSGH_ID + 1 &&
+        rep.reply.header.msgh_size == sizeof(x87_coop_reply_t))
+    {
+        /* the patched code was already hot in this process's instruction
+         * cache: invalidate it from here, as the protocol requires */
+        for (i = 0; i < 2; i++)
+            if (rep.reply.icache_len[i])
+                sys_icache_invalidate( (void *)(uintptr_t)rep.reply.icache_addr[i],
+                                       (size_t)rep.reply.icache_len[i] );
+        if (x87_logs()) fprintf( stderr, "x87: acceleration on\n" );
+    }
+    else fprintf( stderr, "x87: no reply from the sidecar (%#x), running without x87 acceleration\n", kr );
+
+done:
+    unsetenv( X87_COOP_ENV );
+}
+
+#endif /* __APPLE__ */
