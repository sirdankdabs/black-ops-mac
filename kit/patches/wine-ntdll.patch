+/***********************************************************************
+ *           virtual_set_exec_on_demand
+ *
+ * bo: with DEP turned off, Wine maps every readable page executable. Under
+ * Rosetta that makes all writable data look like code: each write may have to
+ * throw translations away, and an old 32-bit game whose launcher turns DEP
+ * off ran in slow motion. In this mode readable pages keep their protection,
+ * and a page becomes executable the first time code runs from it
+ * (virtual_exec_on_demand), which is what the program sees with DEP off.
+ */
+static BOOL exec_on_demand;
+
+void virtual_set_exec_on_demand( BOOL enable )
+{
+    exec_on_demand = enable;
+}
+
+/* An instruction fetch faulted at addr: make its page executable when that is
+ * what the program asked for by turning DEP off. Called from the signal handler. */
+BOOL virtual_exec_on_demand( void *addr )
+{
+    char *page = ROUND_ADDR( addr, host_page_mask );
+    BOOL ret = FALSE;
+    BYTE vprot;
+
+    if (!exec_on_demand) return FALSE;
+    mutex_lock( &virtual_mutex );  /* no need for signal masking inside signal handler */
+    vprot = get_host_page_vprot( page );
+    if ((vprot & VPROT_COMMITTED) && (vprot & VPROT_READ) && !(vprot & (VPROT_EXEC | VPROT_GUARD)))
+    {
+        set_page_vprot_bits( page, host_page_size, VPROT_EXEC, 0 );
+        mprotect_range( page, host_page_size, 0, 0 );
+        ret = TRUE;
+    }
+    mutex_unlock( &virtual_mutex );
+    if (ret)
+    {
+        static int stats = -1;
+        if (stats < 0) { const char *e = getenv( "BO_STATS" ); stats = e && *e == '1'; }
+        if (stats)
+        {
+            struct timespec ts;
+            clock_gettime( CLOCK_MONOTONIC, &ts );
+            fprintf( stderr, "[stat] %ld.%03ld exec-on-demand %p\n", (long)ts.tv_sec, ts.tv_nsec / 1000000, page );
+        }
+    }
+    return ret;
 }
 
 
