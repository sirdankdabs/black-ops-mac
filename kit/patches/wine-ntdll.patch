+/***********************************************************************
+ * bo: emulated execution breakpoints for 32-bit (wow64) code under Rosetta
+ *
+ * Rosetta does not deliver x86 debug-register traps, so Wine could only
+ * pretend that setting them worked; a program that waits for its breakpoint
+ * (Plutonium sets one on the instruction after a call) waits forever.
+ *
+ * An enabled execution breakpoint of a thread (DR0-DR3 with R/W 00 in DR7)
+ * is armed as an int3 written over the first byte of its instruction, with a
+ * trampoline that runs the original instruction and jumps back. When the
+ * int3 traps:
+ *  - in a thread that has that breakpoint enabled, it is reported as the
+ *    hardware would: EXCEPTION_SINGLE_STEP at the address, Eip on it, DR6
+ *    naming the register;
+ *  - in any other thread, execution goes on through the trampoline.
+ * Resuming on the address with RF (EFLAGS bit 16) set, as handlers do to
+ * run the instruction once, also goes through the trampoline. A breakpoint
+ * is disarmed (the byte restored) when no thread has it enabled any more.
+ * Data breakpoints (R/W other than 00) are not emulated.
+ */
+
+#define BO_BP_MAX     64
+#define BO_TRAMP_SIZE 32
+#define BO_EFLAGS_RF  0x10000
+
+struct bo_bp
+{
+    volatile ULONG addr;  /* 0: free */
+    LONG  refs;           /* threads that have it enabled */
+    BYTE  orig;           /* the byte under the int3 */
+    volatile LONG hidden; /* original byte put back while a handler runs */
+    BYTE *tramp;          /* original instruction + jump back, NULL if it cannot be relocated */
+};
+
+static struct bo_bp bo_bps[BO_BP_MAX];
+static pthread_mutex_t bo_bp_mutex = PTHREAD_MUTEX_INITIALIZER;
+static BYTE *bo_tramp_page;
+static SIZE_T bo_tramp_used, bo_tramp_size;
+
+static int bo_modrm_len( const BYTE *p )
+{
+    BYTE mod = p[0] >> 6, rm = p[0] & 7;
+    int len = 1;
+
+    if (mod == 3) return 1;
+    if (rm == 4)
+    {
+        len++;
+        if (mod == 0 && (p[1] & 7) == 5) len += 4;
+    }
+    else if (mod == 0 && rm == 5) len += 4;
+    if (mod == 1) len += 1;
+    else if (mod == 2) len += 4;
+    return len;
+}
+
+enum { BO_REL_NONE, BO_REL_JMP, BO_REL_CALL, BO_REL_JCC };
+
+/* Length of the 32-bit instruction at p (at address addr), 0 if unknown.
+ * Relative jumps and calls set *rel, *target and, for a jcc, *cond. */
+static int bo_insn_len( const BYTE *p, ULONG addr, int *rel, ULONG *target, BYTE *cond )
+{
+    int i = 0, imm = 4;
+    BYTE op;
+
+    *rel = BO_REL_NONE;
+    for (;; i++)
+    {
+        BYTE b = p[i];
+        if (b == 0x66) imm = 2;
+        else if (b == 0x67) return 0;  /* 16-bit addressing */
+        else if (b != 0xf0 && b != 0xf2 && b != 0xf3 && b != 0x26 && b != 0x2e &&
+                 b != 0x36 && b != 0x3e && b != 0x64 && b != 0x65) break;
+        if (i >= 4) return 0;
+    }
+    op = p[i++];
+
+    if (op == 0x0f)
+    {
+        BYTE op2 = p[i++];
+        if (op2 >= 0x80 && op2 <= 0x8f)
+        {
+            if (imm != 4) return 0;
+            *rel = BO_REL_JCC;
+            *cond = op2 - 0x80;
+            *target = addr + i + 4 + *(const INT *)(p + i);
+            return i + 4;
+        }
+        if (op2 == 0x38) { i++; return i + bo_modrm_len( p + i ); }
+        if (op2 == 0x3a) { i++; return i + bo_modrm_len( p + i ) + 1; }
+        switch (op2)
+        {
+        case 0x05: case 0x06: case 0x07: case 0x08: case 0x09: case 0x0b: case 0x0e:
+        case 0x30 ... 0x37: case 0x77: case 0xa0: case 0xa1: case 0xa2: case 0xa8:
+        case 0xa9: case 0xaa: case 0xc8 ... 0xcf:
+            return i;
+        case 0x70 ... 0x73: case 0xa4: case 0xac: case 0xba: case 0xc2:
+        case 0xc4: case 0xc5: case 0xc6:
+            return i + bo_modrm_len( p + i ) + 1;
+        default:
+            return i + bo_modrm_len( p + i );
+        }
+    }
+    if (op >= 0x70 && op <= 0x7f)
+    {
+        *rel = BO_REL_JCC;
+        *cond = op - 0x70;
+        *target = addr + i + 1 + (signed char)p[i];
+        return i + 1;
+    }
+    if (op < 0x40)
+    {
+        switch (op & 7)
+        {
+        case 0: case 1: case 2: case 3: return i + bo_modrm_len( p + i );
+        case 4: return i + 1;
+        case 5: return i + imm;
+        default: return i;
+        }
+    }
+    switch (op)
+    {
+    case 0x40 ... 0x61: case 0x6c ... 0x6f: case 0x90 ... 0x99: case 0x9b ... 0x9f:
+    case 0xa4 ... 0xa7: case 0xaa ... 0xaf: case 0xc3: case 0xc9: case 0xcb: case 0xcc:
+    case 0xce: case 0xcf: case 0xd6: case 0xd7: case 0xec ... 0xef: case 0xf1: case 0xf4:
+    case 0xf5: case 0xf8 ... 0xfd:
+        return i;
+    case 0x62: case 0x63: case 0x84 ... 0x8f: case 0xc4: case 0xc5: case 0xd0 ... 0xd3:
+    case 0xd8 ... 0xdf: case 0xfe: case 0xff:
+        return i + bo_modrm_len( p + i );
+    case 0x6a: case 0xa8: case 0xb0 ... 0xb7: case 0xcd: case 0xd4: case 0xd5: case 0xe4 ... 0xe7:
+        return i + 1;
+    case 0x68: case 0xa9: case 0xb8 ... 0xbf:
+        return i + imm;
+    case 0x69: case 0x81: case 0xc7:
+        return i + bo_modrm_len( p + i ) + imm;
+    case 0x6b: case 0x80: case 0x82: case 0x83: case 0xc0: case 0xc1: case 0xc6:
+        return i + bo_modrm_len( p + i ) + 1;
+    case 0xa0 ... 0xa3:
+        return i + 4;
+    case 0xc2: case 0xca:
+        return i + 2;
+    case 0xc8:
+        return i + 3;
+    case 0x9a: case 0xea:
+        return i + 6;
+    case 0xf6: case 0xf7:
+    {
+        int len = i + bo_modrm_len( p + i );
+        if (((p[i] >> 3) & 7) < 2) len += (op == 0xf6) ? 1 : imm;
+        return len;
+    }
+    case 0xe8: case 0xe9:
+        if (imm != 4) return 0;
+        *rel = (op == 0xe8) ? BO_REL_CALL : BO_REL_JMP;
+        *target = addr + i + 4 + *(const INT *)(p + i);
+        return i + 4;
+    case 0xeb:
+        *rel = BO_REL_JMP;
+        *target = addr + i + 1 + (signed char)p[i];
+        return i + 1;
+    }
+    return 0;  /* loop/jcxz and anything unknown */
+}
+
+static BYTE *bo_emit_jmp( BYTE *t, ULONG to )
+{
+    t[0] = 0xe9;
+    *(INT *)(t + 1) = to - (PtrToUlong( t ) + 5);
+    return t + 5;
+}
+
+/* Build the trampoline for the instruction at addr (called before the int3
+ * is written). Trampolines live in memory below 2 GB, so 32-bit code can
+ * reach them. Called with bo_bp_mutex held. */
+static BYTE *bo_make_tramp( ULONG addr )
+{
+    const BYTE *code = ULongToPtr( addr );
+    BYTE *start, *t, cond = 0;
+    ULONG target = 0;
+    int rel, len = bo_insn_len( code, addr, &rel, &target, &cond );
+
+    if (!len || len > 15) return NULL;
+    if (!bo_tramp_page || bo_tramp_used + BO_TRAMP_SIZE > bo_tramp_size)
+    {
+        void *mem = NULL;
+        SIZE_T size = 0x10000;
+        if (NtAllocateVirtualMemory( GetCurrentProcess(), &mem, 0x7fffffff, &size,
+                                     MEM_RESERVE | MEM_COMMIT, PAGE_EXECUTE_READWRITE ))
+            return NULL;
+        bo_tramp_page = mem;
+        bo_tramp_size = size;
+        bo_tramp_used = 0;
+    }
+    start = t = bo_tramp_page + bo_tramp_used;
+    bo_tramp_used += BO_TRAMP_SIZE;
+
+    switch (rel)
+    {
+    case BO_REL_NONE:
+        memcpy( t, code, len );
+        t = bo_emit_jmp( t + len, addr + len );
+        break;
+    case BO_REL_JMP:
+        t = bo_emit_jmp( t, target );
+        break;
+    case BO_REL_CALL:
+        t[0] = 0x68;  /* push return address */
+        *(ULONG *)(t + 1) = addr + len;
+        t = bo_emit_jmp( t + 5, target );
+        break;
+    case BO_REL_JCC:
+        t[0] = 0x0f;
+        t[1] = 0x80 + cond;
+        *(INT *)(t + 2) = target - (PtrToUlong( t ) + 6);
+        t = bo_emit_jmp( t + 6, addr + len );
+        break;
+    }
+    return start;
+}
+
+static BOOL bo_poke( ULONG addr, BYTE value )
+{
+    void *base = ULongToPtr( addr );
+    SIZE_T size = 1;
+    ULONG old, dummy;
+
+    if (NtProtectVirtualMemory( GetCurrentProcess(), &base, &size, PAGE_EXECUTE_READWRITE, &old ))
+        return FALSE;
+    *(volatile BYTE *)ULongToPtr( addr ) = value;
+    base = ULongToPtr( addr );
+    size = 1;
+    NtProtectVirtualMemory( GetCurrentProcess(), &base, &size, old, &dummy );
+    return TRUE;
+}
+
+static struct bo_bp *bo_bp_find( ULONG addr )
+{
+    int i;
+    for (i = 0; i < BO_BP_MAX; i++) if (bo_bps[i].addr == addr) return &bo_bps[i];
+    return NULL;
+}
+
+static void bo_bp_arm( ULONG addr )
+{
+    struct bo_bp *bp;
+
+    pthread_mutex_lock( &bo_bp_mutex );
+    if ((bp = bo_bp_find( addr ))) bp->refs++;
+    else if ((bp = bo_bp_find( 0 )))
+    {
+        bp->orig = *(volatile BYTE *)ULongToPtr( addr );
+        bp->tramp = bo_make_tramp( addr );
+        bp->refs = 1;
+        __atomic_store_n( &bp->addr, addr, __ATOMIC_SEQ_CST );
+        if (!bo_poke( addr, 0xcc ))
+        {
+            bp->addr = 0;
+            ERR_(seh)( "cannot write the breakpoint at %08x\n", (unsigned)addr );
+        }
+        else TRACE_(seh)( "armed %08x, trampoline %p\n", (unsigned)addr, bp->tramp );
+        if (!bp->tramp) FIXME_(seh)( "instruction at %08x cannot be stepped over\n", (unsigned)addr );
+    }
+    else ERR_(seh)( "too many breakpoints, %08x not armed\n", (unsigned)addr );
+    pthread_mutex_unlock( &bo_bp_mutex );
+}
+
+static void bo_bp_disarm( ULONG addr )
+{
+    struct bo_bp *bp;
+
+    pthread_mutex_lock( &bo_bp_mutex );
+    if ((bp = bo_bp_find( addr )) && !--bp->refs)
+    {
+        bo_poke( addr, bp->orig );
+        bp->hidden = 0;
+        __atomic_store_n( &bp->addr, 0, __ATOMIC_SEQ_CST );
+        TRACE_(seh)( "disarmed %08x\n", (unsigned)addr );
+    }
+    pthread_mutex_unlock( &bo_bp_mutex );
+}
+
+/* Breakpoints whose original byte was put back for a handler: write the int3
+ * again once the thread resumes (the hardware would trap again too). */
+static void bo_bp_rearm_hidden(void)
+{
+    int i;
+
+    for (i = 0; i < BO_BP_MAX; i++)
+    {
+        struct bo_bp *bp = &bo_bps[i];
+        if (!bp->addr || !bp->hidden) continue;
+        pthread_mutex_lock( &bo_bp_mutex );
+        if (bp->addr && bp->hidden && bp->refs > 0 && bo_poke( bp->addr, 0xcc ))
+        {
+            bp->hidden = 0;
+            if (bo_drlog > 0) fprintf( stderr, "[drlog] rearm %08x thread %04x\n", (unsigned)bp->addr, (unsigned)GetCurrentThreadId() );
+        }
+        pthread_mutex_unlock( &bo_bp_mutex );
+    }
+}
+
+/* The address of debug register i if DR7 enables it as an execution breakpoint. */
+static ULONG bo_exec_bp( DWORD_PTR dr7, DWORD_PTR addr, int i )
+{
+    if (!(dr7 & (3 << (2 * i)))) return 0;
+    if ((dr7 >> (16 + 4 * i)) & 3)
+    {
+        static int warned;
+        if (!warned++) FIXME_(seh)( "data breakpoints are not emulated (dr7 %08lx)\n", (unsigned long)dr7 );
+        return 0;
+    }
+    return addr;
+}
+
+/* The current thread sets its own debug registers: arm what it enables,
+ * disarm what it no longer does. Called before the cached registers change. */
+static void bo_bp_update_self( const I386_CONTEXT *context )
+{
+    const DWORD_PTR old_dr[4] = { amd64_thread_data()->dr0, amd64_thread_data()->dr1,
+                                  amd64_thread_data()->dr2, amd64_thread_data()->dr3 };
+    const DWORD new_dr[4] = { context->Dr0, context->Dr1, context->Dr2, context->Dr3 };
+    DWORD_PTR old_dr7 = amd64_thread_data()->dr7;
+    int i;
+
+    if (!((context->ContextFlags & ~CONTEXT_i386) & CONTEXT_I386_DEBUG_REGISTERS)) return;
+    for (i = 0; i < 4; i++)
+    {
+        ULONG old_bp = bo_exec_bp( old_dr7, old_dr[i], i );
+        ULONG new_bp = bo_exec_bp( context->Dr7, new_dr[i], i );
+        if (old_bp == new_bp) continue;
+        if (old_bp) bo_bp_disarm( old_bp );
+        if (new_bp) bo_bp_arm( new_bp );
+    }
+}
+
+/* Resuming at an armed address with RF set runs the original instruction. */
+static BOOL bo_bp_resume_fixup( const I386_CONTEXT *context, I386_CONTEXT *copy )
+{
+    struct bo_bp *bp;
+
+    if (!(context->EFlags & BO_EFLAGS_RF) || !context->Eip) return FALSE;
+    if (!(bp = bo_bp_find( context->Eip )) || !bp->tramp) return FALSE;
+    *copy = *context;
+    copy->Eip = PtrToUlong( bp->tramp );
+    copy->EFlags &= ~BO_EFLAGS_RF;
+    return TRUE;
+}
+
+/* An int3 trapped in 32-bit code: one of ours? */
+static BOOL bo_bp_trap( ucontext_t *ucontext )
+{
+    EXCEPTION_RECORD rec = { 0 };
+    struct xcontext context;
+    const DWORD_PTR dr[4] = { amd64_thread_data()->dr0, amd64_thread_data()->dr1,
+                              amd64_thread_data()->dr2, amd64_thread_data()->dr3 };
+    struct bo_bp *bp;
+    ULONG addr;
+    int i;
+
+    if (!bo_bp_active || CS_sig(ucontext) == cs64_sel) return FALSE;
+    addr = (ULONG)RIP_sig(ucontext) - 1;
+    if (!(bp = bo_bp_find( addr )))
+    {
+        if (bo_drlog > 0)
+        {
+            const BYTE *c = ULongToPtr( addr - 400 );
+            int k;
+            fprintf( stderr, "[drlog] foreign int3 at %08x eax=%08x ebx=%08x ecx=%08x edx=%08x esi=%08x edi=%08x esp=%08x ebp=%08x code:",
+                     (unsigned)addr, (unsigned)RAX_sig(ucontext), (unsigned)RBX_sig(ucontext), (unsigned)RCX_sig(ucontext),
+                     (unsigned)RDX_sig(ucontext), (unsigned)RSI_sig(ucontext), (unsigned)RDI_sig(ucontext),
+                     (unsigned)RSP_sig(ucontext), (unsigned)RBP_sig(ucontext) );
+            for (k = 0; k < 420; k++) fprintf( stderr, " %02x", c[k] );
+            fprintf( stderr, "\n[drlog] stack:" );
+            for (k = 0; k < 16; k++) fprintf( stderr, " %08x", ((const ULONG *)(ULONG_PTR)RSP_sig(ucontext))[k] );
+            fprintf( stderr, "\n" );
+        }
+        return FALSE;
+    }
+
+    for (i = 0; i < 4; i++)
+    {
+        if (bo_exec_bp( amd64_thread_data()->dr7, dr[i], i ) != addr) continue;
+        /* this thread's breakpoint: report it as the hardware would */
+        RIP_sig(ucontext) = addr;
+        amd64_thread_data()->dr6 = 0xffff0ff0 | (1 << i);
+        bo_bp_saved_dr[0] = amd64_thread_data()->dr0;
+        bo_bp_saved_dr[1] = amd64_thread_data()->dr1;
+        bo_bp_saved_dr[2] = amd64_thread_data()->dr2;
+        bo_bp_saved_dr[3] = amd64_thread_data()->dr3;
+        bo_bp_saved_dr[4] = amd64_thread_data()->dr6;
+        bo_bp_saved_dr[5] = amd64_thread_data()->dr7;
+        /* A hardware breakpoint leaves the code as it is, and handlers read
+         * it (Plutonium checks the instruction it stopped on): put the
+         * original byte back until the thread resumes. */
+        if (bo_poke( addr, bp->orig )) bp->hidden = 1;
+        {
